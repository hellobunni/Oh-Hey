{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2017",
    "jsx": "preserve",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "lib": [
      "ES2017",
      "DOM",
      "DOM.Iterable"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true
  },
  "exclude": [
    "node_modules"
  ]
}
